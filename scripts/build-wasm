#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
engine="${FANTA_EDIT_DIR:-$root/.engine/fanta-edit}"
if [[ ! -f "$engine/crates/fanta-runtime/Cargo.toml" ]]; then
  echo "No fanta-edit checkout with crates/fanta-runtime at ${engine}. Run ./scripts/fetch-engine or set FANTA_EDIT_DIR." >&2
  exit 1
fi
if [[ -z "${EMSDK:-}" ]]; then
  echo "Set EMSDK to an activated Emscripten 6.0.12 SDK." >&2
  exit 1
fi
export EMSDK_QUIET=1
source "$EMSDK/emsdk_env.sh"
if ! emcc --version | head -n 1 | grep -q '6\.0\.12'; then
  echo "This runtime requires Emscripten 6.0.12." >&2
  exit 1
fi
# Inside the checkout so its rust-toolchain.toml selects the compiler.
cd "$engine"
rustup target add wasm32-unknown-emscripten
export EMCC_CFLAGS="-sMAX_WEBGL_VERSION=2 -sERROR_ON_UNDEFINED_SYMBOLS=0"
export CARGO_TARGET_WASM32_UNKNOWN_EMSCRIPTEN_LINKER="$root/scripts/fanta-runtime-linker"
export RUSTFLAGS="${RUSTFLAGS:-} -C panic=abort -C link-arg=-sMODULARIZE=1 -C link-arg=-sEXPORT_ES6=1 -C link-arg=-sEXPORT_NAME=createFantaModule -C link-arg=-sENVIRONMENT=web,node -C link-arg=-sALLOW_MEMORY_GROWTH=1 -C link-arg=-sMAXIMUM_MEMORY=536870912 -C link-arg=-sDYNAMIC_EXECUTION=0 -C link-arg=-sMAX_WEBGL_VERSION=2 -C link-arg=-sDEFAULT_TO_CXX=1 -C link-arg=-sDISABLE_EXCEPTION_CATCHING=0 -C link-arg=-sSUPPORT_LONGJMP=emscripten -C link-arg=-sERROR_ON_UNDEFINED_SYMBOLS=0 -C link-arg=-sEXPORTED_RUNTIME_METHODS=GL,HEAPU8 -C link-arg=-sEXPORTED_FUNCTIONS=_fanta_alloc,_fanta_buffer_len,_fanta_free,_fanta_request,_main"
cargo build --locked --release --target wasm32-unknown-emscripten -p fanta-runtime --bin fanta-runtime-wasm
target="${CARGO_TARGET_DIR:-$engine/target}"
dist="$root/packages/runtime/dist"
mkdir -p "$dist"
cp "$target/wasm32-unknown-emscripten/release/fanta-runtime-wasm.js" "$dist/fanta-runtime.mjs"
cp "$target/wasm32-unknown-emscripten/release/fanta_runtime_wasm.wasm" "$dist/fanta_runtime_wasm.wasm"
